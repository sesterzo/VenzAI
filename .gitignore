# Old plug-in versions, diagnostic dumps and runtime artefacts kept locally.
# Not source: 3.7 MB of logs, exported images, an archive and personal notes
# (server address and SSH public key).
backup/

# Runtime artefacts, in case an older build still writes into the bundle.
# Current code writes the log to Lightroom's own log folder and working files
# to the OS temp directory, so these should never reappear.
*.log
VenzAI.lrdevplugin/venzai_reference.*

# Compiled Lua, if luac is ever run with an output file.
*.luac

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Records the bundle hash at the last build bump (see .claude/hooks/bump-build.sh).
.claude/.build-stamp

# Claude Code workspace: hooks, settings and the build-number stamp. Local
# tooling, not part of the plug-in.
.claude/

# Working documents - specs, plans and design notes. Kept on disk while the
# work is in progress; they are not what someone downloading the plug-in came
# for, and they go stale the moment the code moves past them.
docs/
tests/__pycache__/
